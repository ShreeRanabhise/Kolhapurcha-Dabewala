rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anyone can read approved vendors and global settings
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if request.auth != null; 
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anyone can submit an application, but only authenticated users can read/edit them
    match /applications/{appId} {
      allow create: if true; 
      allow read, update, delete: if request.auth != null;
    }

    // Subscriptions: Customers read their own, vendors read their own
    match /subscriptions/{subId} {
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow read, update: if request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid);
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Payments: Customers read their own, vendors read their own
    match /payments/{paymentId} {
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow read, update: if request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid);
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
